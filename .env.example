# BHASHINI API CONFIGURATION: Powers the Indian Regional Voice Assistant (NLTM / MeitY)
# Get credentials from Bhashini ULCA platform: https://bhashini.gov.in/ulca/user/register
BHASHINI_API_KEY="YOUR_BHASHINI_API_KEY"
BHASHINI_USER_ID="YOUR_BHASHINI_USER_ID"
BHASHINI_INFERENCE_API_KEY="YOUR_BHASHINI_INFERENCE_API_KEY"

# GEMINI_API_KEY: Optional/fallback for catalog generation and vision
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase database config (Optional: if set, synchronizes with remote Supabase project)
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."


